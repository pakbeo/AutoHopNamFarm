local CoreGui = game:GetService("CoreGui")
local statusLabel = nil
local statsLabel = nil
local lastStatus = ""

local function createStatusUI()
    pcall(function()
        if CoreGui:FindFirstChild("NamFarmItemUI") then CoreGui.NamFarmItemUI:Destroy() end
        local screenGui = Instance.new("ScreenGui")
        screenGui.Name = "NamFarmItemUI"
        screenGui.Parent = CoreGui
        
        local mainFrame = Instance.new("Frame")
        mainFrame.Size = UDim2.new(0, 320, 0, 85) 
        mainFrame.Position = UDim2.new(0.5, -160, 0, 20) 
        mainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
        mainFrame.BackgroundTransparency = 0.15
        mainFrame.BorderSizePixel = 0
        mainFrame.Parent = screenGui

        local uiCorner = Instance.new("UICorner")
        uiCorner.CornerRadius = UDim.new(0, 8)
        uiCorner.Parent = mainFrame

        local uiStroke = Instance.new("UIStroke")
        uiStroke.Color = Color3.fromRGB(255, 170, 0)
        uiStroke.Thickness = 2
        uiStroke.Parent = mainFrame

        local titleLabel = Instance.new("TextLabel")
        titleLabel.Size = UDim2.new(1, 0, 0, 25)
        titleLabel.Position = UDim2.new(0, 0, 0, 5)
        titleLabel.BackgroundTransparency = 1
        titleLabel.TextColor3 = Color3.fromRGB(255, 170, 0)
        titleLabel.TextSize = 16
        titleLabel.Font = Enum.Font.GothamBold
        titleLabel.Text = "Nam Farm Hub - Auto Item"
        titleLabel.Parent = mainFrame

        statusLabel = Instance.new("TextLabel")
        statusLabel.Size = UDim2.new(1, -20, 0, 25)
        statusLabel.Position = UDim2.new(0, 10, 0, 30)
        statusLabel.BackgroundTransparency = 1
        statusLabel.TextColor3 = Color3.fromRGB(240, 240, 240)
        statusLabel.TextSize = 13
        statusLabel.Font = Enum.Font.GothamSemibold
        statusLabel.Text = "Starting up..."
        statusLabel.TextWrapped = true
        statusLabel.Parent = mainFrame

        statsLabel = Instance.new("TextLabel")
        statsLabel.Size = UDim2.new(1, -20, 0, 25)
        statsLabel.Position = UDim2.new(0, 10, 0, 55)
        statsLabel.BackgroundTransparency = 1
        statsLabel.TextColor3 = Color3.fromRGB(85, 255, 85) 
        statsLabel.TextSize = 13
        statsLabel.Font = Enum.Font.GothamBold
        statsLabel.Text = "💵: $0 | 🏹 Lucky: 0"
        statsLabel.TextWrapped = true
        statsLabel.Parent = mainFrame
    end)
end

local function updateStatus(msg)
    local stats = Player:FindFirstChild("PlayerStats")
    local money = (stats and stats:FindFirstChild("Money")) and tostring(stats.Money.Value) or "0"
    local luckyCount = 0
    pcall(function()
        if Player.Backpack then
            for _, v in pairs(Player.Backpack:GetChildren()) do
                if v.Name == "Lucky Arrow" then luckyCount = luckyCount + 1 end
            end
        end
        if Player.Character then
            for _, v in pairs(Player.Character:GetChildren()) do
                if v.Name == "Lucky Arrow" then luckyCount = luckyCount + 1 end
            end
        end
    end)

    if statusLabel then statusLabel.Text = msg end
    if statsLabel then statsLabel.Text = "💵: $" .. money .. " | 🏹 Lucky: " .. tostring(luckyCount) end

    if not Config.Webhook.Enabled or Config.Webhook.Url == "" then return end
    if msg == lastStatus then return end
    lastStatus = msg
    
    local requestFunc = syn and syn.request or http_request or request or (http and http.request)
    if requestFunc then
        pcall(function()
            local content = {
                ["content"] = "",
                ["embeds"] = {{
                    ["title"] = "Nam Farm Hub - Auto Item", ["color"] = tonumber(0xFFAA00), 
                    ["fields"] = {
                        {["name"] = "👤 Player", ["value"] = "||" .. Player.Name .. "||", ["inline"] = true},
                        {["name"] = "💵 Money", ["value"] = "$" .. money, ["inline"] = true},
                        {["name"] = "🏹 Lucky", ["value"] = tostring(luckyCount), ["inline"] = true},
                        {["name"] = "🔄 Status", ["value"] = "```" .. msg .. "```", ["inline"] = false}
                    },
                    ["footer"] = {["text"] = "Nam Farm Hub | " .. os.date("%H:%M:%S")}
                }}
            }
            requestFunc({Url = Config.Webhook.Url, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = game:GetService("HttpService"):JSONEncode(content)})
        end)
    end
end

createStatusUI()
updateStatus("Connecting to game...")

