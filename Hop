local PlaceID = game.PlaceId
local HttpService = game:GetService('HttpService')
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")

local HopSettings = getgenv().Config and getgenv().Config.HopSettings or {
    MaxPlayers = 15,
    MinPlayers = 8,
    MaxRetries = 5,
    SortOrder = "Desc"
}

local AllIDs = {}
local foundAnything = ""
local actualHour = os.date("!*t").hour
local fileName = "NFH_VisitedServers.json"

local function LoadVisitedServers()
    pcall(function()
        local fileContent = readfile(fileName)
        if fileContent then
            AllIDs = HttpService:JSONDecode(fileContent)
        end
    end)

    if type(AllIDs) ~= "table" or AllIDs[1] ~= actualHour then
        AllIDs = {actualHour}
        pcall(function() writefile(fileName, HttpService:JSONEncode(AllIDs)) end)
    end
end

local function TPReturner()
    local currentSort = HopSettings.SortOrder or "Desc"
    local url = 'https://games.roblox.com/v1/games/' .. PlaceID .. '/servers/Public?sortOrder=' .. currentSort .. '&limit=100'
    
    if foundAnything ~= "" then
        url = url .. '&cursor=' .. foundAnything
    end

    local success, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)

    if not success or not result or not result.data then 
        return false 
    end

    if result.nextPageCursor then
        foundAnything = result.nextPageCursor
    end

    local potentialServers = {}
    
    for _, v in pairs(result.data) do
        local ID = tostring(v.id)
        local playing = tonumber(v.playing)

        if playing >= HopSettings.MinPlayers and playing <= HopSettings.MaxPlayers then
            local isVisited = false
            for i = 2, #AllIDs do
                if ID == tostring(AllIDs[i]) then
                    isVisited = true
                    break
                end
            end
            
            if not isVisited then
                table.insert(potentialServers, ID)
            end
        end
    end

    if #potentialServers > 0 then
        local randomID = potentialServers[math.random(1, #potentialServers)]
        table.insert(AllIDs, randomID)
        pcall(function() writefile(fileName, HttpService:JSONEncode(AllIDs)) end)
        TeleportService:TeleportToPlaceInstance(PlaceID, randomID, Players.LocalPlayer)
        return true
    end

    return false
end

LoadVisitedServers()
local retries = 0

while true do
    local isTeleporting = TPReturner()
    if isTeleporting then
        task.wait(15)
    else
        retries = retries + 1
        if retries >= HopSettings.MaxRetries then
            task.wait(5)
            retries = 0
            foundAnything = "" 
        else
            task.wait(1.5) 
        end
    end
end
