local PlaceID = game.PlaceId
local HttpService = game:GetService('HttpService')
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")

local AllIDs = {}
local foundAnything = ""
local actualHour = os.date("!*t").hour

pcall(function()
    local fileContent = readfile("NotSameServers.json")
    if fileContent then
        AllIDs = HttpService:JSONDecode(fileContent)
    end
end)

if type(AllIDs) ~= "table" or AllIDs[1] ~= actualHour then
    AllIDs = {actualHour}
    pcall(function() writefile("NotSameServers.json", HttpService:JSONEncode(AllIDs)) end)
end

local function TPReturner()
    task.wait(math.random(1, 5)) 

    local url = 'https://games.roblox.com/v1/games/' .. PlaceID .. '/servers/Public?sortOrder=Asc&limit=100'
    if foundAnything ~= "" then
        url = url .. '&cursor=' .. foundAnything
    end

    local success, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)

    if not success or not result or not result.data then return false end

    if result.nextPageCursor then
        foundAnything = result.nextPageCursor
    end

    local potentialServers = {}
    
    for _, v in pairs(result.data) do
        local ID = tostring(v.id)
        local playing = tonumber(v.playing)
        local maxPlayers = tonumber(v.maxPlayers)

        if maxPlayers > playing and playing >= 1 then
            local isVisited = false
            for i = 2, #AllIDs do
                if ID == tostring(AllIDs[i]) then
                    isVisited = true
                    break
                end
            end
            
            if not isVisited then
                table.insert(potentialServers, ID)
            end
        end
        
        if #potentialServers >= 15 then break end
    end

    if #potentialServers > 0 then
        local randomID = potentialServers[math.random(1, #potentialServers)]
        
        table.insert(AllIDs, randomID)
        pcall(function() writefile("NotSameServers.json", HttpService:JSONEncode(AllIDs)) end)
        
        TeleportService:TeleportToPlaceInstance(PlaceID, randomID, Players.LocalPlayer)
        return true
    end

    return false
end

local function Teleport()
    while true do
        local isTeleporting = TPReturner()
        if isTeleporting then
            task.wait(10)
        else
            task.wait(1) 
        end
    end
end

Teleport()
